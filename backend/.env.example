# Server configuration
PORT=5000
NODE_ENV=development

# SQLite File-based Database Connection
DATABASE_URL="file:./dev.db"

# (Redis is fully disabled and removed!)

# Elasticsearch service URL (Optional: Elasticsearch is offline by default, search falls back to SQLite queries)
ELASTICSEARCH_URL="http://localhost:9200"

# JWT token signature secret
JWT_SECRET="super-secret-reachinbox-key"

# Client Web Application URL
FRONTEND_URL="http://localhost:5173"

# Scheduler concurrency setting
WORKER_CONCURRENCY=5

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://localhost:5000/api/auth/google/callback"


# Slack App OAuth2 Credentials
SLACK_CLIENT_ID="YOUR_SLACK_CLIENT_ID"
SLACK_CLIENT_SECRET="YOUR_SLACK_CLIENT_SECRET"
SLACK_REDIRECT_URI="http://localhost:5000/api/slack/callback"

# SMTP Service Configuration (e.g. Ethereal Email SMTP)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@reachinbox.ai"

# Rate Limiting & Throttling
MAX_EMAILS_PER_HOUR=100
EMAIL_DELAY_MS=2000
